{
  "name": "claudekit-engineer",
  "version": "2.19.1",
  "description": "A lean, standard ClaudeKit for core software-engineering workflows with Claude Code.",
  "scripts": {
    "test": "node --test claude/hooks/__tests__/*.test.cjs claude/hooks/__tests__/scout-block/*.test.cjs claude/hooks/__tests__/integration/*.test.cjs claude/scripts/scan_skills.test.cjs claude/hooks/lib/__tests__/ck-config-utils.test.cjs claude/hooks/lib/__tests__/context-builder.test.cjs claude/hooks/lib/__tests__/project-detector.test.cjs claude/hooks/lib/__tests__/statusline.test.cjs claude/hooks/lib/__tests__/statusline-integration.test.cjs",
    "test:statusline": "node claude/hooks/lib/__tests__/statusline-suite.cjs",
    "test:worktree": "node --test claude/scripts/worktree.test.cjs",
    "lint": "python3 claude/scripts/validate-skill-frontmatter.py && python3 claude/scripts/validate-skill-crossrefs.py claude/skills/",
    "verify": "bash init.sh",
    "eval:static": "python3 eval/tier0_static.py",
    "eval:audit": "python3 eval/audit_harness.py",
    "eval:coverage": "python3 eval/coverage.py",
    "eval:unit": "python3 -m unittest eval/test_run.py",
    "eval": "python3 eval/run.py --all --variant-a full-kit --model claude-opus-5 --effort high",
    "eval:mock": "python3 eval/run.py --all --mock",
    "eval:mock-noop": "python3 eval/run.py --all --mock-noop",
    "eval:effort-sweep": "python3 eval/effort_sweep.py --all --variant full-kit --model claude-opus-5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/duy-tung/claude-code-setup.git"
  },
  "keywords": [
    "claude-code",
    "ai-agents",
    "development-template",
    "boilerplate",
    "automation",
    "cli-tools"
  ],
  "author": "Duy Nguyen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/duy-tung/claude-code-setup/issues"
  },
  "homepage": "https://github.com/duy-tung/claude-code-setup#readme",
  "claudekit": {
    "sourceDir": "claude",
    "runtimeDir": ".claude"
  },
  "files": [
    ".claude/",
    "plans/",
    "README.md",
    "LICENSE",
    ".claude/metadata.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
