# Claude Code - Global Environment Variables
# Location: .claude/.env   (copy this template and fill in values)
# Setup: Copy to .claude/.env and configure
#
# Resolution order (highest priority first) — a more specific .env wins:
#   process.env -> <skill>/.env -> .claude/skills/.env -> .claude/.env (this file) -> ~/.claude/.env

# ============================================
# Context7 API Configuration (optional)
# ============================================
# Get your API key from https://context7.com/dashboard/api-keys
CONTEXT7_API_KEY=

# ============================================
# AI/ML API Keys (Global Defaults)
# ============================================
# Google Gemini API (used by Gemini-CLI execution paths, e.g. the research/scout skills)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI API Key (if using OpenAI-based skills)
# OPENAI_API_KEY=

# Anthropic API Key (if using Claude API directly)
# ANTHROPIC_API_KEY=

# ============================================
# Development & CI/CD
# ============================================
# NODE_ENV=development
# DEBUG=false
# LOG_LEVEL=info

# ============================================
# Project Configuration
# ============================================
# PROJECT_NAME=claudekit-engineer
# ENVIRONMENT=local
